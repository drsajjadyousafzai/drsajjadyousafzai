---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import BtnArrow from '../components/BtnArrow.astro';
import PatientStoryCard from '../components/PatientStoryCard.astro';
import { physicianSchema, personSchema, faqSchema } from '../lib/schema';
import heroPhoto from '../assets/doctor/hero-sjd.jpg';
import aboutPhoto from '../assets/doctor/sajjad-about.jpg';
import aboutPhotoSecondary from '../assets/doctor/dr-sajjad-ceremony.webp';

const serviceImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/services/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const serviceImage = (id: string) => {
  const entry = Object.entries(serviceImages).find(([path]) => path.includes(`/${id}.`));
  return entry?.[1].default;
};

const site = (await getEntry('siteSettings', 'settings'))!.data;
const doctor = (await getEntry('doctor', 'profile'))!.data;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

// Varicose veins has three distinct treatments, so it expands into three grid
// cards (one per treatment) instead of the usual one card per service.
const gridItems = services.flatMap((s) => {
  if (s.id === 'varicose-veins' && s.data.treatmentOptions) {
    return s.data.treatmentOptions.map((t) => ({
      href: `/services/${s.id}`,
      title: t.title,
      iconKey: t.iconKey,
      photo: t.photoId ? serviceImage(t.photoId) : undefined,
    }));
  }
  return [{ href: `/services/${s.id}`, title: s.data.title, iconKey: s.data.iconKey, photo: serviceImage(s.id) }];
});
const testimonials = (await getCollection('testimonials')).map((t) => t.data);
const videoStories = (await getCollection('patientStories'))
  .map((s) => s.data)
  .filter((s) => s.featured)
  .sort((a, b) => a.order - b.order);
const allFaqs = (await getCollection('faqs')).map((f) => f.data);
const homeFaqs = allFaqs.filter((f) => ['Pain', 'Cost', 'Recovery'].includes(f.category)).slice(0, 6);

const waText = encodeURIComponent('Assalam o alaikum, I would like to book an appointment with Dr. Sajjad Yousafzai.');
const waLink = `https://wa.me/${site.whatsapp}?text=${waText}`;

const visitSteps = [
  { n: '01', title: 'You Sit Down and Talk', body: 'You tell Dr. Sajjad what you feel, in your own words. He listens without rushing you.' },
  { n: '02', title: 'He Examines You', body: 'He looks at your legs or the affected area, and may use an ultrasound scan there and then to see the blood flow.' },
  { n: '03', title: 'He Explains It Plainly', body: 'He tells you what is wrong and why, often with a simple drawing, so you and your family understand it.' },
  { n: '04', title: 'You Decide Together', body: 'He explains your choices, what each involves, the recovery and the cost. Nothing is done without your agreement.' },
];

const seoTitle = 'Vascular Surgeon in Peshawar | Dr. Sajjad Yousafzai';
const seoDesc = 'Dr. Sajjad Yousafzai, consultant vascular surgeon in Peshawar. Varicocele surgery, varicose veins, AV fistula and more. Rated 5/5 by 460+ verified Google reviews. Call today.';

const jsonLd = [
  physicianSchema(site, { rating: 5, count: 460 }),
  personSchema(site),
  faqSchema(homeFaqs),
];
---
<BaseLayout title={seoTitle} description={seoDesc} path="/" jsonLd={jsonLd} heroOverlay>

  <!-- ============================ HERO ============================ -->
  <section class="hero" id="hero">
    <div class="hero-card">
      <div class="hero-media">
        <Image
          src={heroPhoto}
          alt="Dr. Sajjad Yousafzai, consultant vascular surgeon in Peshawar"
          class="hero-photo"
          widths={[520, 760, 1040]}
          sizes="(max-width: 900px) 100vw, 55vw"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero-fade"></span>
      </div>
      <span class="hero-scrim" aria-hidden="true"></span>
      <svg class="hero-vessel" viewBox="0 0 1200 700" fill="none" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
        <path class="draw" d="M-40 120 C220 170 380 40 600 120 C820 200 980 90 1240 150" stroke="rgba(255,255,255,0.16)" stroke-width="1.5" />
        <path class="draw draw-2" d="M-40 600 C260 540 420 660 700 590 C940 530 1060 620 1240 570" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" />
      </svg>

      <div class="hero-inner container">
        <h1 class="hero-title reveal">Dr. Sajjad Yousafzai</h1>

        <p class="hero-sub reveal" data-delay="90">
          Peshawar's top vascular, endovascular and microvascular surgeon.<br />
          Pak Medical Centre, Room No. 337, 3rd Floor, Khyber Bazar, Peshawar.
        </p>

        <div class="hero-actions reveal" data-delay="170">
          <a href="/contact" class="btn btn--primary hero-cta">Book Appointment<BtnArrow /></a>
          <span class="hero-rating">
            <span class="hr-stars" aria-hidden="true">
              <Icon name="star" size={14} /><Icon name="star" size={14} /><Icon name="star" size={14} /><Icon name="star" size={14} /><Icon name="star" size={14} />
            </span>
            <span class="hr-text"><strong class="tnum">5.0</strong> from 460+ Google reviews</span>
          </span>
        </div>

        
      </div>
    </div>
  </section>

  <!-- ========================= TRUST BAR ========================= -->
  <section class="section--tight trust-wrap">
    <div class="container">
      <ul class="trust-bar">
        <li class="reveal"><strong class="tnum" data-count="10" data-suffix="+">0+</strong><span>years in surgery</span></li>
        <li class="reveal" data-delay="80"><strong class="tnum" data-count="460" data-suffix="+">0+</strong><span>verified patient reviews</span></li>
        <li class="reveal" data-delay="160"><strong class="tnum" data-count="5" data-decimals="1"><span>out of 5</span></strong><span>average patient rating</span></li>
        <li class="reveal" data-delay="240"><strong class="lrh">Lady Reading Hospital</strong><span>MTI, Peshawar</span></li>
      </ul>
    </div>
  </section>

  <!-- ==================== ABOUT TEASER ==================== -->
  <section class="section about-teaser">
    <div class="container about-grid">
      <div class="about-visual reveal">
        <span class="about-lines" aria-hidden="true"></span>
        <div class="about-image" role="img" aria-label="Dr. Sajjad Yousafzai at Lady Reading Hospital">
          <Image src={aboutPhoto} alt="Dr. Sajjad Yousafzai, consultant vascular surgeon at Lady Reading Hospital" class="about-photo" width={560} height={616} />
        </div>
        <div class="about-image about-image--secondary" role="img" aria-label="Dr. Sajjad Yousafzai receiving his fellowship at the College of Physicians and Surgeons Pakistan">
          <Image src={aboutPhotoSecondary} alt="Dr. Sajjad Yousafzai receiving his fellowship at the College of Physicians and Surgeons Pakistan" class="about-photo" width={420} height={330} />
        </div>
      </div>
      <div class="about-copy">
        <h2 class="reveal" data-delay="80">A specialist who takes the time to explain.</h2>
        <p class="reveal" data-delay="140">{doctor.bio[1]}</p>
        <p class="reveal" data-delay="180">{doctor.bio[3]}</p>
        <ul class="about-points reveal" data-delay="220">
          <li><span class="chk" aria-hidden="true"><Icon name="check" size={16} /></span>Over ten years in surgery, four of them dedicated to vascular work</li>
          <li><span class="chk" aria-hidden="true"><Icon name="check" size={16} /></span>Consultant at Lady Reading Hospital, the province's main referral centre</li>
          <li><span class="chk" aria-hidden="true"><Icon name="check" size={16} /></span>Other doctors send their own patients to him</li>
        </ul>
        <a href="/about" class="btn btn--ghost reveal" data-delay="260">More about Dr. Sajjad<BtnArrow /></a>
      </div>
    </div>
  </section>

  <!-- ==================== CONDITION GRID ==================== -->
  <section class="section conditions-section">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 class="reveal" data-delay="80">Dr. Sajjad's Services</h2>
        <p class="reveal" data-delay="140">Each problem starts with what you actually feel. Tap any card to learn what is happening and what can be done.</p>
      </div>
      <div class="condition-grid">
        {gridItems.map((item, i) => (
          <a href={item.href} class="condition-card reveal" data-delay={String((i % 4) * 70)}>
            <div class="cc-frame">
              <div class="cc-media">
                {item.photo ? (
                  <Image src={item.photo} alt={item.title} class="cc-photo" width={480} height={560} />
                ) : (
                  <span class="cc-icon" aria-hidden="true"><Icon name={item.iconKey} size={30} /></span>
                )}
              </div>
              <div class="cc-overlay" aria-hidden="true"></div>
              <span class="cc-label">{item.title}</span>
            </div>
            <span class="cc-arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== VIDEO PATIENT STORIES ==================== -->
  <section class="section video-stories-section" id="patient-stories">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 class="reveal" data-delay="80">Patient Stories</h2>
        <p class="reveal" data-delay="140">Real patients, treatment, recovery and results.</p>
      </div>
      <!-- the cards start piled up and fan out into the grid as the section
           scrolls through, so the layout itself is the reveal -->
      <div class="video-stories-grid" data-story-stack>
        {videoStories.map((v, i) => (
          <div class="vs-item">
            <PatientStoryCard video={v.video} poster={v.poster} index={i + 1} />
          </div>
        ))}
      </div>
      <div class="video-stories-cta reveal">
        <a href="/cases" class="btn btn--ghost">View all patient stories<BtnArrow /></a>
      </div>
    </div>
  </section>

  <!-- ==================== FIRST VISIT ==================== -->
  <section class="section visit-section">
    <div class="visit-bg" aria-hidden="true">
      <Image src={heroPhoto} alt="" class="visit-bg-photo" width={1600} height={1200} loading="lazy" />
    </div>
    <div class="container">
      <div class="section-head section-head--center reveal">
        <h2>What Happens at Your First Visit</h2>
        <p>Many people feel nervous before seeing a surgeon. Here is exactly what to expect, so you can come in knowing how it will go.</p>
      </div>
      <ol class="visit-steps">
        {visitSteps.map((step, i) => (
          <li class="visit-step" style={`--i:${i}`}>
            <div class="visit-card">
              <span class="vs-num tnum" aria-hidden="true">{step.n}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="visit-note reveal">You are always welcome to bring a family member into the room with you.</p>
    </div>
  </section>

  <!-- ==================== PATIENT STORIES ==================== -->
  <section class="section stories-section">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 class="reveal" data-delay="80">What Patients Say</h2>
        <p class="reveal" data-delay="140">Rated 5 out of 5 by more than 460 verified patients on Google, with 100 percent reporting they were satisfied.</p>
      </div>
      <div class="stories-grid">
        {testimonials.map((t, i) => (
          <figure class="card story-card reveal" data-delay={String((i % 2) * 90)}>
            {t.byDoctor && <span class="story-tag">From a referring doctor</span>}
            <span class="story-quote-icon" aria-hidden="true"><Icon name="quote" size={26} /></span>
            <blockquote>{t.quote}</blockquote>
            <figcaption>
              <div class="story-stars" aria-label={`${t.rating} out of 5 stars`}>
                {Array.from({ length: t.rating }).map(() => <Icon name="star" size={15} />)}
              </div>
              <strong>{t.name}</strong>
              <span>{t.procedure} · via {t.source}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="stories-cta reveal">
        <a href="/cases" class="btn btn--ghost">View All Reviews<BtnArrow /></a>
      </div>
    </div>
  </section>

  <!-- ==================== FAQ ==================== -->
  <section class="section faq-section">
    <div class="container faq-grid">
      <div class="faq-intro">
        <h2 class="reveal" data-delay="80">Frequently Asked Questions</h2>
        <p class="lede reveal" data-delay="140">These are fair questions and you deserve plain answers. Here are the ones patients ask most.</p>
        <a href="/contact" class="btn btn--primary reveal" data-delay="200">Ask your own question<BtnArrow /></a>
      </div>
      <div class="faq-list reveal" data-delay="120">
        {homeFaqs.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary><span>{f.question}</span><span class="faq-plus" aria-hidden="true"></span></summary>
            <div class="faq-answer"><p>{f.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== LOCATION ==================== -->
  <section class="section location-section">
    <div class="container location-grid">
      <div class="location-copy">
        <h2 class="reveal" data-delay="80">Clinic in Khyber Bazar, Peshawar</h2>
        <ul class="location-facts reveal" data-delay="140">
          <li><span class="lf-icon" aria-hidden="true"><Icon name="map" size={20} /></span>
            <div><strong>{site.addressLine}</strong><span>{site.addressLocality}, {site.addressRegion}. {site.landmark}</span></div></li>
          <li><span class="lf-icon" aria-hidden="true"><Icon name="clock" size={20} /></span>
            <div><strong>Clinic hours</strong><span>{site.clinicHours}</span></div></li>
          <li><span class="lf-icon" aria-hidden="true"><Icon name="stethoscope" size={20} /></span>
            <div><strong>Online video consultation</strong><span>{site.onlineHours}</span></div></li>
          <li><span class="lf-icon" aria-hidden="true"><Icon name="phone" size={20} /></span>
            <div><strong>Phone</strong><span><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></span></div></li>
        </ul>
        <div class="location-actions reveal" data-delay="200">
          <a href={site.mapDirections} class="btn btn--ghost" rel="noopener"><Icon name="map" size={18} />Get directions</a>
          <a href={waLink} class="btn btn--whatsapp" rel="noopener"><Icon name="whatsapp" size={18} />Message on WhatsApp</a>
        </div>
      </div>
      <div class="location-map reveal" data-delay="120">
        <div class="map-frame">
          <iframe
            class="map-embed"
            src={site.mapEmbed}
            title="Map of the clinic in Khyber Bazar"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>


</BaseLayout>

<style>
  /* ---------- HERO ----------
     A single full-bleed photo card, inset from the page edges, with the
     header floating on top of it. Copy sits bottom-left over a scrim. */
  .hero {
    --hero-pad: clamp(8px, 1vw, 14px);
    /* neutral charcoal, deliberately not the brand navy: a blue field beside
       the photo reads as a coloured panel rather than as darkened room */
    --hero-bg: #071A2F;
    --hero-bg-rgb: 7, 26, 47;
    position: relative; z-index: 1; padding: var(--hero-pad);
  }
  .hero-card {
    position: relative; isolation: isolate; overflow: hidden;
    /* fills the viewport bar the small inset, like the reference */
    min-height: max(600px, calc(100vh - var(--hero-pad) * 2));
    min-height: max(600px, calc(100svh - var(--hero-pad) * 2));
    display: flex; align-items: flex-end;
    border-radius: clamp(18px, 2vw, 30px);
    background: linear-gradient(115deg, #04101F 0%, var(--hero-bg) 58%, #0E2B47 100%);
    box-shadow: var(--shadow-lg);
  }

  .hero-media { position: absolute; inset: 0 0 0 auto; width: min(62%, 780px); z-index: -2; }
  .hero-photo { width: 100%; height: 100%; object-fit: cover; object-position: 52% 14%; }
  /* melt the right-hand photo into the charcoal field on its left edge and base */
  .hero-fade {
    position: absolute; inset: 0;
    background:
      radial-gradient(70% 80% at 52% 36%, transparent 42%, rgba(var(--hero-bg-rgb), 0.4) 100%),
      linear-gradient(90deg, var(--hero-bg) 0%, rgba(var(--hero-bg-rgb), 0.9) 14%, rgba(var(--hero-bg-rgb), 0.42) 42%, rgba(var(--hero-bg-rgb), 0.1) 72%, rgba(var(--hero-bg-rgb), 0.02) 100%),
      linear-gradient(0deg, var(--hero-bg) 0%, rgba(var(--hero-bg-rgb), 0.18) 26%, transparent 54%);
  }
  /* plain bottom-up wash for legibility, no colour cast */
  .hero-scrim {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(0deg,
      rgba(var(--hero-bg-rgb), 0.9) 0%,
      rgba(var(--hero-bg-rgb), 0.55) 26%,
      rgba(var(--hero-bg-rgb), 0.12) 52%,
      transparent 72%);
  }
  .hero-vessel { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: 0.45; }

  /* pull the gutter in by the card inset so hero copy lines up with the header */
  .hero-inner {
    position: relative; z-index: 1;
    padding-block: clamp(2.5rem, 5vw, 4.25rem);
    padding-inline: calc(var(--gutter) - var(--hero-pad));
  }
  /* em-based cap breaks the name onto two lines at every size ("Dr. Sajjad" /
     "Yousafzai"); ch is unreliable here because Jost's figures are wide */
  .hero-title {
    color: #fff; font-size: clamp(2.6rem, 8.2vw, 6.5rem); font-weight: 600;
    line-height: 1.08; letter-spacing: -0.03em; max-width: 8.4em;
  }
  .hero-sub {
    margin-top: clamp(1rem, 2vw, 1.5rem); max-width: 58ch;
    color: rgba(255, 255, 255, 0.88); font-size: clamp(1rem, 1.15vw, 1.14rem); line-height: 1.55;
    text-shadow: 0 1px 14px rgba(4, 15, 27, 0.6);
  }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: clamp(1.75rem, 3vw, 2.5rem); }
  .hero-cta { padding-block: 0.85rem; }

  .hero-rating { display: inline-flex; align-items: center; gap: 0.55rem; color: rgba(255, 255, 255, 0.9); }
  .hr-stars { display: inline-flex; gap: 1px; color: #FFC24A; }
  .hr-text { font-size: 0.9rem; }
  .hr-text strong { color: #fff; font-weight: 700; }

  .hero-microtrust {
    display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
    margin-top: 1.35rem; font-size: 0.88rem; color: rgba(255, 255, 255, 0.62);
  }
  .hero-microtrust :global(svg) { color: #3ED37E; flex: none; }
  .hero-microtrust a { color: #fff; text-decoration-color: rgba(255, 255, 255, 0.5); }

  .draw { stroke-dasharray: 2400; stroke-dashoffset: 2400; animation: draw-in 3s ease forwards 0.4s; }
  .draw-2 { animation-delay: 0.8s; }
  @keyframes draw-in { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .draw { stroke-dashoffset: 0; animation: none; } }

  /* ---------- TRUST BAR ---------- */
  .trust-wrap { position: relative; z-index: 1; }
  .trust-bar { list-style: none; padding: 1.6rem clamp(1rem, 3vw, 2rem); margin: 0; display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1rem; background: var(--ink); border-radius: var(--radius-lg); box-shadow: var(--shadow); text-align: center; }
  .trust-bar li { display: grid; gap: 4px; padding: 0.4rem 0.6rem; position: relative; }
  .trust-bar li:not(:last-child)::after { content: ""; position: absolute; right: 0; top: 20%; height: 60%; width: 1px; background: rgba(255,255,255,0.14); }
  .trust-bar strong { font-size: clamp(1.7rem, 4vw, 2.4rem); font-weight: 800; color: #fff; line-height: 1; }
  .trust-bar strong span { font-size: 0.9rem; font-weight: 500; color: #9FC3E6; }
  .trust-bar .lrh { font-size: clamp(1.05rem, 2.4vw, 1.35rem); }
  .trust-bar span { color: #9FC3E6; font-size: 0.85rem; }

  /* ---------- CONDITION GRID ---------- */
  .condition-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.1rem; }
  /* badge geometry: --cc-b = badge size, --cc-o = inset from card edges, --cc-g = gap cut around badge */
  .condition-card { --cc-b: 52px; --cc-o: 0px; --cc-g: 5px;
    position: relative; display: block; aspect-ratio: 3/3.6; text-decoration: none;
    transition: transform 0.32s cubic-bezier(.2,.8,.2,1); }
  .condition-card:hover, .condition-card:focus-visible { transform: translateY(-6px); }
  .cc-frame { position: absolute; inset: 0; border-radius: var(--radius-lg); overflow: hidden;
    background: linear-gradient(160deg, var(--blue) 0%, var(--ink) 100%); box-shadow: var(--shadow-sm);
    transition: box-shadow 0.32s ease;
    /* punch a circular notch in the bottom-right corner so the badge reads as separated */
    --cc-cx: calc(100% - var(--cc-o) - var(--cc-b) / 2);
    --cc-cy: calc(100% - var(--cc-o) - var(--cc-b) / 2);
    --cc-r: calc(var(--cc-b) / 2 + var(--cc-g));
    -webkit-mask: radial-gradient(circle var(--cc-r) at var(--cc-cx) var(--cc-cy), transparent 99%, #000 100%);
    mask: radial-gradient(circle var(--cc-r) at var(--cc-cx) var(--cc-cy), transparent 99%, #000 100%); }
  .condition-card:hover .cc-frame, .condition-card:focus-visible .cc-frame { box-shadow: var(--shadow-lg); }
  .cc-media { position: absolute; inset: 0; }
  .cc-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s cubic-bezier(.2,.8,.2,1); }
  .condition-card:hover .cc-photo, .condition-card:focus-visible .cc-photo { transform: scale(1.08); }
  .cc-icon { position: absolute; inset: 0; display: grid; place-items: center; color: rgba(255,255,255,0.35); }
  .cc-overlay { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(7,26,47,0.92) 0%, rgba(7,26,47,0.35) 46%, rgba(7,26,47,0.08) 68%, transparent 82%);
    transition: background 0.32s ease; }
  .condition-card:hover .cc-overlay, .condition-card:focus-visible .cc-overlay { background: linear-gradient(0deg, rgba(7,26,47,0.96) 0%, rgba(7,26,47,0.5) 50%, rgba(7,26,47,0.12) 72%, transparent 88%); }
  .cc-label { position: absolute; left: 1.1rem; right: calc(var(--cc-b) + var(--cc-o) + 0.9rem); bottom: 1.15rem;
    color: #fff; font-weight: 700; font-size: 1.02rem; line-height: 1.25; text-transform: capitalize; }
  .cc-arrow { position: absolute; right: var(--cc-o); bottom: var(--cc-o); width: var(--cc-b); height: var(--cc-b);
    border-radius: 50%; display: grid; place-items: center; background: var(--artery); color: #fff;
    transition: background 0.28s ease, transform 0.28s cubic-bezier(.2,.8,.2,1); }
  .cc-arrow :global(svg) { transform: rotate(-45deg); transition: transform 0.28s cubic-bezier(.2,.8,.2,1); }
  .condition-card:hover .cc-arrow, .condition-card:focus-visible .cc-arrow { background: var(--blue); color: #fff; }
  .condition-card:hover .cc-arrow :global(svg), .condition-card:focus-visible .cc-arrow :global(svg) { transform: rotate(-45deg) translateX(2px); }

  /* ---------- ABOUT TEASER ---------- */
  .about-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .about-visual { position: relative; padding: 0 2.2rem 2.6rem 0; }
