---
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
const site = (await getEntry('siteSettings', 'settings'))!.data;
const waText = encodeURIComponent('Assalam o alaikum, I would like to ask about an appointment with Dr. Sajjad Yousafzai.');
---
<div class="mobile-bar" role="region" aria-label="Quick contact">
  <a href={`tel:${site.phone}`} class="mb-btn mb-call"><Icon name="phone" size={20} /><span>Call</span></a>
  <a href={`https://wa.me/${site.whatsapp}?text=${waText}`} class="mb-btn mb-wa" rel="noopener"><Icon name="whatsapp" size={20} /><span>WhatsApp</span></a>
  <a href="/contact" class="mb-btn mb-book"><Icon name="stethoscope" size={20} /><span>Book</span></a>
</div>

<style>
  .mobile-bar {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 120;
    display: none; grid-template-columns: repeat(3, 1fr);
    background: var(--ink);
    padding: 0.4rem 0.4rem calc(0.4rem + env(safe-area-inset-bottom, 0px));
    box-shadow: 0 -8px 24px rgba(7,26,47,0.25);
  }
  .mb-btn {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    min-height: 54px; color: #fff; text-decoration: none; font-size: 0.8rem; font-weight: 600;
    border-radius: 12px; margin: 0 2px;
  }
  .mb-call { background: var(--blue); }
  .mb-wa { background: #1FA855; }
  .mb-book { background: var(--artery); }
  .mb-btn:active { transform: translateY(1px); }
  @media (max-width: 940px) { .mobile-bar { display: grid; } }
</style>
